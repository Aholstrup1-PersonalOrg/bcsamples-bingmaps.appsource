{
  "$schema": "https://raw.githubusercontent.com/aholstrup1/AL-Go/aholstrup1-nuget-workspace-compiler-poc/Actions/.Modules/settings.schema.json",
  "type": "AppSource App",
  "templateUrl": "https://github.com/aholstrup1/AL-Go@aholstrup1-nuget-workspace-compiler-poc",
  "runs-on": "ubuntu-latest",
  "unusedALGoSystemFiles": [
    "AddExistingAppOrTestApp.yaml",
    "CreateApp.yaml",
    "CreateTestApp.yaml",
    "CreatePerformanceTestApp.yaml"
  ],
  "useCompilerFolder": false,
  "doNotPublishApps": true,
  "doNotSignApps": true,
  "doNotBuildTests": true,
  "doNotRunTests": true,
  "doNotRunBcptTests": true,
  "workspaceCompilation": {
    "enabled": true,
    "dependencyResolution": "NuGet",
    "ALToolVersion": "18.0.0-beta",
    "toolPackageUrl": "https://github.com/Aholstrup1-PersonalOrg/bcsamples-bingmaps.appsource/raw/nuget-workspace-compile-uptake/.altool/Microsoft.Dynamics.BusinessCentral.Development.Tools.18.0.0-beta.nupkg"
  },
  "useProjectDependencies": true,
  "trackALAlertsInGitHub": true,
  "templateSha": "b404e7e37e550c6c3a75177a4426a28c54f60715",
  "PullRequestTrigger": "pull_request"
}
