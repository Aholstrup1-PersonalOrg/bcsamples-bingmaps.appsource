{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go/workspaces/artifact-free-compilation/Actions/.Modules/settings.schema.json",
  "type": "AppSource App",
  "templateUrl": "https://github.com/microsoft/AL-Go@workspaces/artifact-free-compilation",
  "runs-on": "ubuntu-latest",
  "unusedALGoSystemFiles": [
    "AddExistingAppOrTestApp.yaml",
    "CreateApp.yaml",
    "CreateTestApp.yaml",
    "CreatePerformanceTestApp.yaml"
  ],
  "deliverToAppSource": {
    "branches": [
      "main",
      "e2e"
    ]
  },
  "useCompilerFolder": true,
  "workspaceCompilation": {
    "enabled": true,
    "useTemporaryAlTool": true
  },
  "doNotSignApps": true,
  "doNotPublishApps": true,
  "AZURE_CREDENTIALSSecretName": "AZURE_CREDENTIALS",
  "useProjectDependencies": true,
  "trustedSigning": {
    "Endpoint": "https://neu.codesigning.azure.net",
    "Account": "BCCodeSigningTest",
    "CertificateProfile": "BCCodeSigningPublic"
  },
  "trackALAlertsInGitHub": true,
  "templateSha": "dc64319583ffefdff051a1b7d1ce071d9ea5efb4",
  "PullRequestTrigger": "pull_request",
  "CodeReviewAgent": {
    "enabled": true
  }
}
